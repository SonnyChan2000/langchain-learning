# ==== 数字列表操作 ====
print("="*30 + "数字列表操作" + "=" * 30)
numbers = [34, 12, 89, 5, 45, 22, 67, 9, 33, 56]

max_num = numbers[0]
min_num = numbers[0]
total = 0
even_num = 0

for number in numbers:
    if number > max_num:
        max_num = number
    if number < min_num:
        min_num = number
    if number % 2 == 0:
        even_num += 1
    total += number
average = total / len(numbers)
print(f"最大值是{max_num}, 最小值是{min_num}")
print(f"平均值是{average}")

print("比平均值大的有：", end=" ")
for number in numbers:
    if number > average:
        print(number, end=",")
print()

numbers.sort()
print(numbers)

print(f"偶数的个数有{even_num}")







    
    





    






